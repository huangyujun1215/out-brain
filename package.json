{
  "name": "nbboss-ai-brain",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @nbboss/api --filter @nbboss/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:integration": "pnpm --filter @nbboss/api test:integration",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @nbboss/api prisma:generate",
    "db:migrate": "pnpm --filter @nbboss/api prisma:migrate",
    "db:push": "pnpm --filter @nbboss/api prisma:push"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1"
  }
}
