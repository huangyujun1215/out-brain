{
  "name": "@nbboss/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "pnpm build && node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:integration": "RUN_INTEGRATION=true vitest run test/api.integration.spec.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@nestjs/common": "11.1.8",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.8",
    "@nestjs/jwt": "11.0.1",
    "@nestjs/platform-express": "11.1.8",
    "@nbboss/contracts": "workspace:*",
    "@prisma/client": "6.19.0",
    "argon2": "0.44.0",
    "bullmq": "5.61.2",
    "cookie-parser": "1.4.7",
    "ioredis": "5.8.2",
    "nanoid": "5.1.6",
    "nodemailer": "7.0.10",
    "pdfjs-dist": "5.4.394",
    "pptxgenjs": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typebox": "1.0.64",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.8",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.5",
    "@types/multer": "2.0.0",
    "@types/node": "24.10.0",
    "@types/nodemailer": "7.0.3",
    "prisma": "6.19.0",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.0.3"
  }
}
